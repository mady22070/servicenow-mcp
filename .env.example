# ServiceNow MCP Server Environment Configuration
# Copy this file to .env and update with your values

# =============================================================================
# ServiceNow Instance Configuration
# =============================================================================

# Development Environment (Required)
SERVICENOW_DEV_INSTANCE_URL=https://devXXX.service-now.com
SERVICENOW_DEV_USERNAME=your_dev_username
SERVICENOW_DEV_PASSWORD=your_dev_password

# Test Environment (Optional)
SERVICENOW_TEST_INSTANCE_URL=https://testXXX.service-now.com
SERVICENOW_TEST_USERNAME=your_test_username
SERVICENOW_TEST_PASSWORD=your_test_password

# Production Environment (Optional)
SERVICENOW_PROD_INSTANCE_URL=https://yourinstance.service-now.com
SERVICENOW_PROD_USERNAME=your_prod_username
SERVICENOW_PROD_PASSWORD=your_prod_password

# =============================================================================
# MCP Server Configuration
# =============================================================================

# Logging Configuration
MCP_LOG_LEVEL=INFO
MCP_LOG_FILE=logs/servicenow-mcp.log

# Security Configuration
# Comma-separated list of allowed tables (leave empty to allow all)
MCP_ALLOW_TABLES=sys_script,sys_script_include,ui_policy,ui_policy_action

# Comma-separated list of blocked tables
MCP_BLOCKED_TABLES=sys_user_password,oauth_entity

# Performance Configuration
MCP_CONNECTION_TIMEOUT=30
MCP_REQUEST_TIMEOUT=60
MCP_MAX_RETRIES=3
MCP_CACHE_TTL=300

# Connection Pool Configuration
MCP_MAX_CONNECTIONS=10
MCP_CONNECTION_POOL_SIZE=5

# =============================================================================
# Transport Configuration
# =============================================================================

# "stdio" (default) for Claude Desktop, "http" for everything else
MCP_TRANSPORT=stdio

# HTTP mode — only used when MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8000

# If set, HTTP clients must send: Authorization: Bearer <value>
# Leave empty to run without auth (only do this on a trusted/private network)
MCP_API_KEY=

# =============================================================================
# Development Configuration
# =============================================================================

# Enable debug mode (development only)
DEBUG=false

# Enable dry run mode by default
DEFAULT_DRY_RUN=false

# Enable request/response logging
LOG_REQUESTS=false
LOG_RESPONSES=false

# =============================================================================
# Optional: Advanced Configuration
# =============================================================================

# Redis Configuration (if using Redis for caching)
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Database Configuration (if using database for persistence)
DATABASE_URL=sqlite:///servicenow_mcp.db

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_PORT=9090

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# =============================================================================
# Docker Configuration
# =============================================================================

# Docker Compose Configuration
COMPOSE_PROJECT_NAME=servicenow-mcp

# Container Configuration
CONTAINER_PORT=8000
CONTAINER_LOG_LEVEL=INFO

# =============================================================================
# CI/CD Configuration
# =============================================================================

# GitHub Actions Secrets (for reference)
# SERVICENOW_DEV_INSTANCE_URL
# SERVICENOW_DEV_USERNAME  
# SERVICENOW_DEV_PASSWORD
# PYPI_API_TOKEN
# DOCKERHUB_USERNAME
# DOCKERHUB_TOKEN

# =============================================================================
# Security Notes
# =============================================================================

# IMPORTANT: Never commit this file with real credentials!
# 
# 1. Copy this file to .env
# 2. Update with your actual values
# 3. Ensure .env is in your .gitignore
# 4. Use strong passwords and rotate them regularly
# 5. Consider using OAuth for production environments
# 6. Limit ServiceNow user permissions to minimum required
# 7. Use separate accounts for different environments
# 8. Monitor access logs regularly

# =============================================================================
# Usage Examples
# =============================================================================

# Start the MCP server:
# python mcp_adapter.py

# Run health check:
# python doctor.py

# Run with Docker:
# docker-compose up -d

# Run tests:
# pytest tests/

# Format code:
# black servicenow_mcp/
# isort servicenow_mcp/